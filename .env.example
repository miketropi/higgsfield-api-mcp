# Environment for the local integration stack (docker-compose.yml).
#
#   cp .env.example .env      # then replace every placeholder below
#   docker compose up -d --wait
#
# `.env` is git-ignored (.gitignore: `.env`, `.env.*`, `!.env.example`) and is the
# ONLY place stack secrets live: docker-compose.yml contains references, never
# values. Variable names are exactly the ones `@higgsfield-mcp/config` reads
# (packages/config/src/env.ts) unless the comment says "compose-only".
#
# Never reuse these values outside a local/dev machine, and never commit a real
# credential: a real deployment reads the same variable names from its own secret
# store and points HF_MCP_S3_ENDPOINT at real object storage.

# ---------------------------------------------------------------------------
# Postgres (compose-only inputs; the gateway's HF_MCP_DATABASE_URL is derived)
# ---------------------------------------------------------------------------
POSTGRES_USER=higgsfield
POSTGRES_PASSWORD=REPLACE_ME_postgres_password
POSTGRES_DB=higgsfield_mcp
# No host port is published by this stack (see docker-compose.yml "HOST PORTS"):
# containers use postgres:5432 on the internal network. To reach PostgreSQL from
# the host: docker compose exec postgres psql -U higgsfield -d higgsfield_mcp
# To publish one, uncomment the `ports:` block on the postgres service.

# ---------------------------------------------------------------------------
# Redis (compose-only inputs; HF_MCP_REDIS_URL is derived)
# ---------------------------------------------------------------------------
REDIS_PASSWORD=REPLACE_ME_redis_password
# Same policy as PostgreSQL: no published port by default;
#   docker compose exec redis redis-cli -a "$REDIS_PASSWORD"

# ---------------------------------------------------------------------------
# Gateway port / public URL
# ---------------------------------------------------------------------------
# Host-side loopback port for the gateway.
HF_MCP_GATEWAY_PORT=3000
# Must be https and must match the `audience` of every tenant record in the
# tenants file (auth checks `tenant.audience === HF_MCP_PUBLIC_URL`). No TLS is
# terminated by this stack; the value is used for audience matching, callback
# URLs and the RFC 9728 metadata document.
HF_MCP_PUBLIC_URL=https://localhost:3000
# Host-header allowlist for the MCP/HTTP surface (comma-separated, ports are
# ignored). `127.0.0.1,localhost` keeps the published loopback port usable.
HF_MCP_ALLOWED_HOSTS=127.0.0.1,localhost
# Browser Origin allowlist; empty means "reject any request that sends an
# Origin header". Add explicit origins only (wildcards are rejected at startup).
HF_MCP_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Required secrets - every value below is a placeholder and MUST be replaced.
# The stack reads them from this file only; docker-compose.yml never contains a
# credential. Nothing here works against a real account as shipped.
# ---------------------------------------------------------------------------
# Base64 of exactly 32 bytes; the config loader rejects anything else. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
HF_MCP_DATA_ENCRYPTION_KEY=REPLACE_ME_BASE64_32_BYTE_KEY
# Operator bearer token for GET /metrics (distinct from any tenant token).
HF_MCP_METRICS_TOKEN=REPLACE_ME_metrics_token
# Bearer token used by MCP clients against this stack. Only its SHA-256 digest is
# written into the generated tenants file, so this value never leaves `.env`.
HF_MCP_DEV_TOKEN=REPLACE_ME_dev_bearer_token
# Tenant/token identifiers written into the generated tenants file.
HF_MCP_DEV_TENANT_ID=dev
HF_MCP_DEV_TOKEN_ID=dev-token-1
# Stable upstream provider account binding (SPEC: shared across key rotations).
HF_MCP_PROVIDER_ACCOUNT_ID=REPLACE_ME_provider_account_id
# Higgsfield API credential, formatted `Key <id>:<secret>`
# (packages/config/src/types.ts ProviderConfig.credentials). Resolved per tenant
# through providerCredentialsEnv=HF_API_CREDENTIALS.
HF_API_CREDENTIALS=Key REPLACE_ME_key_id:REPLACE_ME_key_secret

# ---------------------------------------------------------------------------
# Object storage (S3-compatible) for HF_MCP_ASSET_MODE=managed
# ---------------------------------------------------------------------------
HF_MCP_S3_ACCESS_KEY_ID=REPLACE_ME_s3_access_key
HF_MCP_S3_SECRET_ACCESS_KEY=REPLACE_ME_s3_secret_key
HF_MCP_S3_BUCKET=higgsfield-assets
HF_MCP_S3_REGION=us-east-1
HF_MCP_S3_PREFIX=higgsfield
# No published host port by default; docker-compose.yml sets
# HF_MCP_S3_ENDPOINT=http://objectstore:8333 on the gateway. Uncomment the
# `ports:` block on the objectstore service to reach the S3 API from the host.

# ---------------------------------------------------------------------------
# Optional overrides (defaults shown; empty = "not set", the loader's default wins)
# ---------------------------------------------------------------------------
# HF_MCP_PROVIDER_BASE_URL=https://api.higgsfield.ai
# HF_MCP_PROVIDER_TIMEOUT_MS=30000
# HF_MCP_PROVIDER_UPLOAD_TIMEOUT_MS=300000
# HF_MCP_LOG_LEVEL=info            # trace|debug|info|warn|error|fatal|silent
# HF_MCP_LOG_PRETTY=false
# HF_MCP_METRICS_ENABLED=true
# HF_MCP_WORKERS_ENABLED=true
# HF_MCP_SHUTDOWN_GRACE_MS=10000
# HF_MCP_BODY_LIMIT_BYTES=1048576
# HF_MCP_MAX_IMAGE_JOBS=10
# HF_MCP_MAX_VIDEO_JOBS=3
# HF_MCP_MAX_UPLOAD_BYTES=104857600
# HF_MCP_DOWNLOAD_TIMEOUT_MS=30000
# HF_MCP_MAX_REDIRECTS=3
# HF_MCP_SIGNED_URL_TTL_SECONDS=900
# HF_MCP_MAX_JOB_COST_USD=              # e.g. 5
# HF_MCP_DAILY_COST_LIMIT_USD=          # e.g. 25
# HF_MCP_REQUIRE_CONFIRM_ABOVE_USD=     # e.g. 1
# HF_MCP_WEBHOOKS_ENABLED=              # defaults to true when HF_MCP_PUBLIC_URL is set
# HF_MCP_EXPERIMENTAL_AGENT_API=false
# HF_MCP_EXPERIMENTAL_DYNAMIC_MODELS=false
# HF_MCP_POLL_INTERVAL_FLOOR_MS=2000
# HF_MCP_POLL_INTERVAL_CEILING_MS=10000
# HF_MCP_POLL_TRANSIENT_BACKOFF_MS=60000
# HF_MCP_REPLAY_BACKOFF_MIN_MS=2000
# HF_MCP_REPLAY_BACKOFF_MAX_MS=60000
# HF_MCP_OAUTH_ISSUER=             # required together with the two below for auth mode oauth_jwt
# HF_MCP_OAUTH_JWKS_URL=
# HF_MCP_OAUTH_AUDIENCE=
# OTEL_EXPORTER_OTLP_ENDPOINT=     # enables tracing when set
# HF_MCP_SERVICE_NAME=higgsfield-mcp
# Absolute paths inside the container; the defaults below are what the image ships.
# HF_MCP_SKILLS_DIR=/app/apps/server/dist/skills
# HF_MCP_TENANTS_FILE=/etc/higgsfield/tenants.json
# HF_MCP_RATE_LIMITS_FILE=/etc/higgsfield/rate-limits.json
# HF_MCP_MODEL_ALIASES_FILE=/etc/higgsfield/model-aliases.json
# HF_MCP_ALLOWED_PATHS=            # local-file inputs; empty denies them in http mode
